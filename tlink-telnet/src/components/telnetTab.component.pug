terminal-toolbar([tab]='this')
    i.fas.fa-xs.fa-circle.text-success.me-2(*ngIf='session && session.open')
    i.fas.fa-xs.fa-circle.text-danger.me-2(*ngIf='!session || !session.open')
    strong.me-auto {{profile.options.host}}:{{profile.options.port}}

    button.btn.btn-sm.btn-link.me-2((click)='reconnect()')
        i.fas.fa-redo
        span(translate) Reconnect

    //- Network-vendor snippet picker. Same modal + service the SSH tab
    //- uses — re-exported from tlink-ssh so we don't duplicate the
    //- regex catalog / snippet packs.
    button.btn.btn-sm.btn-link(
        *ngIf='session && session.open',
        (click)='showSnippetPicker()',
        title='Network snippets'
    )
        i.fas.fa-bolt

    //- Help — searchable quick-reference. Always available so users
    //- troubleshooting a failed connect can read the docs too.
    button.btn.btn-sm.btn-link(
        (click)='openHelp()',
        title='Help'
    )
        i.fas.fa-question-circle

.gnmi-session
    //- ───────────────── Left pane: subscriptions ─────────────────
    .pane.pane-subs
        .pane-title
            span SUBSCRIPTIONS
            span.count {{ subscriptions.length }}

        .sub-list
            .sub-item(*ngFor='let sub of subscriptions; trackBy: trackSubById',
                      [class.active]='sub.running',
                      [class.errored]='!!sub.lastError')
                .sub-path {{ sub.path }}
                .sub-meta
                    span.dot([class.live]='sub.running', [class.dead]='!sub.running')
                    span.mode {{ sub.mode }} · {{ sub.streamMode }}
                    span.rate(*ngIf='sub.mode === "STREAM" && sub.streamMode === "SAMPLE"') {{ sub.sampleIntervalSec }}s
                    span.recv {{ sub.receiveCount }} recv
                .sub-error(*ngIf='sub.lastError') {{ sub.lastError }}
                .sub-actions
                    button.sub-btn(
                        (click)='toggleSaved(sub)',
                        [class.starred]='isSubscriptionSaved(sub)',
                        [title]='isSubscriptionSaved(sub) ? "Unstar subscription (saved to profile)" : "Star subscription (save to profile)"'
                    )
                        i.fas.fa-star(*ngIf='isSubscriptionSaved(sub)')
                        i.far.fa-star(*ngIf='!isSubscriptionSaved(sub)')
                    button.sub-btn(
                        (click)='toggleSubscription(sub)',
                        [title]='sub.running ? "Pause subscription" : "Resume subscription"'
                    )
                        i.fas([class.fa-pause]='sub.running', [class.fa-play]='!sub.running')
                    button.sub-btn.danger(
                        (click)='removeSubscription(sub)',
                        title='Remove subscription'
                    )
                        i.fas.fa-times

            .empty-hint(*ngIf='!subscriptions.length')
                | No subscriptions yet — add a path in the right pane to start streaming.

        //- Saved subscriptions — the "starred" templates for this
        //- target. Kept below Active so the eye lands on live state
        //- first. Auto-start toggle persists to profile; click the
        //- path or the play button to subscribe on demand.
        div(*ngIf='savedSubscriptions.length')
            .pane-title.saved-title
                span SAVED
                span.count {{ savedSubscriptions.length }}

            .sub-list
                .saved-item(
                    *ngFor='let saved of savedSubscriptions; trackBy: trackSavedById',
                    (click)='subscribeFromSaved(saved)',
                    title='Click to subscribe'
                )
                    .sub-path {{ saved.label || saved.path }}
                    .sub-meta
                        span.mode {{ saved.mode }} · {{ saved.streamMode }}
                        span.rate(*ngIf='saved.mode === "STREAM" && saved.streamMode === "SAMPLE"') {{ saved.sampleIntervalSec }}s
                        span.auto-start(
                            [class.on]='saved.autoStart',
                            (click)='toggleSavedAutoStart(saved); $event.stopPropagation()',
                            [title]='saved.autoStart ? "Auto-start ON — click to disable" : "Auto-start OFF — click to enable"'
                        )
                            i.fas.fa-bolt
                            span Auto
                    .sub-actions
                        button.sub-btn.danger(
                            (click)='removeSaved(saved); $event.stopPropagation()',
                            title='Remove from saved'
                        )
                            i.fas.fa-times

    //- ───────────────── Center pane: live stream ─────────────────
    .pane.pane-stream
        .pane-title
            span LIVE STREAM
            span.count.recv-count {{ totalReceived }} recv
            span.count.rate-count(*ngIf='receiveRate > 0') {{ receiveRate }}/s

        .stream-toolbar
            //- 3-way view mode toggle. Same three states from the
            //- Latest-values mockup. Kept as a segmented control so
            //- the currently-active mode reads from a glance.
            .mode-tabs
                button.mode-tab(
                    (click)='setViewMode("wire")',
                    [class.active]='viewMode === "wire"',
                    title='Wire log — every notification as a row'
                ) Wire
                button.mode-tab(
                    (click)='setViewMode("latest")',
                    [class.active]='viewMode === "latest"',
                    title='Latest values — one row per unique path with history'
                ) Latest
                button.mode-tab(
                    (click)='setViewMode("graphical")',
                    [class.active]='viewMode === "graphical"',
                    title='Graphical — chart card per component sharing a metric'
                ) Graphical

            input.filter(
                type='text',
                placeholder='filter path or value…',
                [(ngModel)]='filter'
            )
            button.toolbar-btn(
                *ngIf='viewMode === "wire"',
                (click)='togglePause()',
                [class.active]='paused'
            )
                i.fas.me-1([class.fa-pause]='!paused', [class.fa-play]='paused')
                span(*ngIf='!paused') Pause
                span(*ngIf='paused') Resume ({{ pendingSincePause }})
            button.toolbar-btn((click)='clearStream()')
                i.fas.fa-trash-alt.me-1
                span Clear
            button.toolbar-btn(*ngIf='viewMode === "wire"', (click)='exportStream()')
                i.fas.fa-copy.me-1
                span Export

        //- ───────────── Wire log (original) ─────────────
        div(*ngIf='viewMode === "wire"', style='display: contents')
            .stream
                .stream-head
                    .col-ts Timestamp
                    .col-path Path
                    .col-val Value
                    .col-kind Kind
                .stream-body
                    .empty-hint(*ngIf='!filteredStream.length')
                        span(*ngIf='!stream.length') Waiting for notifications…
                        span(*ngIf='stream.length && !filteredStream.length') No rows match filter.
                    .stream-row(
                        *ngFor='let row of filteredStream; trackBy: trackRowById',
                        [class.deleted]='row.kind === "delete"',
                        [class.selected]='row === selectedRow',
                        (click)='selectRow(row)'
                    )
                        .col-ts {{ formatTimestamp(row.timestampNs) }}
                        .col-path {{ row.path }}
                        .col-val {{ row.valuePreview }}
                        .col-kind {{ row.kind }}

            //- Row detail — only rendered when a row is selected so the
            //- pane collapses cleanly when nothing is picked.
            .row-detail(*ngIf='selectedRow')
                .detail-head
                    span DETAIL
                    span.detail-path {{ selectedRow.path }}
                    button.detail-close((click)='selectRow(selectedRow)')
                        i.fas.fa-times
                pre.detail-body {{ selectedRowJson }}

        //- ───────────── Latest values ─────────────
        .latest-view(*ngIf='viewMode === "latest"')
            .empty-hint(*ngIf='!latestGroups.length')
                span(*ngIf='!latestByPath.size') Waiting for notifications…
                span(*ngIf='latestByPath.size && !latestGroups.length') No rows match filter.

            .lv-header(*ngIf='latestGroups.length')
                .lv-col-path Path
                .lv-col-spark History
                .lv-col-val.right Value
                .lv-col-delta.right Δ
                .lv-col-age.right Age

            .lv-group(*ngFor='let group of latestGroups; trackBy: trackLatestGroup')
                .lv-group-header
                    span.lv-group-name {{ group.prefixPath }}
                    span.lv-group-chip(*ngIf='group.key') {{ group.key }}
                    span.lv-group-count {{ group.rows.length }} leaves

                .lv-row(*ngFor='let row of group.rows; trackBy: trackLatestRow')
                    .lv-col-path
                        span.dim …/
                        | {{ row.shortPath.replace('…/', '') }}
                    .lv-col-spark
                        ng-container(*ngIf='sparklinePaths(row.entry) as spark')
                            svg(viewBox='0 0 100 22', preserveAspectRatio='none')
                                path.fill([attr.d]='spark.fill')
                                path.line([attr.d]='spark.line')
                                circle.endpoint([attr.cx]='spark.endX', [attr.cy]='spark.endY', r='2.5')
                        span.spark-flat(*ngIf='!sparklinePaths(row.entry)') —
                    .lv-col-val
                        span.value {{ row.entry.formatted.value }}
                        span.unit(*ngIf='row.entry.formatted.unit') &nbsp;{{ row.entry.formatted.unit }}
                    .lv-col-delta([ngClass]='"delta-" + deltaOf(row.entry).kind')
                        | {{ deltaOf(row.entry).label }}
                    .lv-col-age
                        span.age-dot(*ngIf='isFresh(row.entry)')
                        | {{ ageLabel(row.entry) }}

        //- ───────────── Graphical (responsive grid) ─────────────
        .gr-view(*ngIf='viewMode === "graphical"')
            .empty-hint(*ngIf='!graphicalCards.length && !latestByPath.size')
                span Waiting for notifications…
            .empty-hint(*ngIf='!graphicalCards.length && latestByPath.size')
                span
                    | No metric with ≥2 components is being sampled yet.
                    | Subscribe to a path that produces numeric leaves across multiple components
                    | (e.g. /components/component/cpu/utilization/state/instant).

            div(*ngIf='graphicalCards.length')
                .gr-summary-strip
                    .gr-metric
                        .k Metric
                        select.gr-metric-select(
                            [(ngModel)]='graphicalMetric',
                            (ngModelChange)='latestDirtySeq = latestDirtySeq + 1'
                        )
                            option([ngValue]='null') Auto ({{ selectedGraphicalMetric || '—' }})
                            option(
                                *ngFor='let m of graphicalMetricCandidates',
                                [ngValue]='m.leaf'
                            ) {{ m.leaf }} ({{ m.componentCount }})
                    .gr-metric
                        .k Cards
                        .v {{ graphicalCards.length }}
                    .gr-metric
                        .k Latest
                        .v {{ graphicalCards[0]?.entry.formatted.value }}{{ graphicalCards[0]?.entry.formatted.unit }}

                .gr-grid
                    .gr-card(*ngFor='let card of graphicalCards; trackBy: trackGraphCard')
                        .gr-card-head
                            span.gr-card-label
                                strong {{ card.label }}
                            span.gr-card-label {{ card.entry.formatted.unit || '' }}
                        .gr-card-value
                            | {{ card.entry.formatted.value }}
                            span.unit(*ngIf='card.entry.formatted.unit') {{ card.entry.formatted.unit }}
                        .gr-chart-wrap
                            ng-container(*ngIf='chartPaths(card.entry) as chart')
                                svg(viewBox='0 0 100 50', preserveAspectRatio='none')
                                    line.grid-line(x1='0', y1='12', x2='100', y2='12')
                                    line.grid-line(x1='0', y1='25', x2='100', y2='25')
                                    line.grid-line(x1='0', y1='38', x2='100', y2='38')
                                    path.area([attr.d]='chart.area')
                                    path.line([attr.d]='chart.line')
                                    circle.endpoint([attr.cx]='chart.endX', [attr.cy]='chart.endY', r='2.5')
                                    text.y-max(x='1', y='10') {{ chart.max }}
                                    text.y-min(x='1', y='48') {{ chart.min }}
                        .gr-card-sub
                            span {{ ageLabel(card.entry) }} ago
                            span([ngClass]='"delta-" + deltaOf(card.entry).kind') {{ deltaOf(card.entry).label }}
            pre.detail-body {{ selectedRowJson }}

    //- ───────────────── Right pane: RPC controls ─────────────────
    .pane.pane-ctrl
        .pane-title RPC

        .ctrl-block
            .ctrl-label Mode
            .ctrl-row
                label([class.selected]='mode === "STREAM"')
                    input(type='radio', name='mode', value='STREAM', [(ngModel)]='mode')
                    span STREAM
                label([class.selected]='mode === "ONCE"')
                    input(type='radio', name='mode', value='ONCE', [(ngModel)]='mode')
                    span ONCE
                label([class.selected]='mode === "POLL"')
                    input(type='radio', name='mode', value='POLL', [(ngModel)]='mode')
                    span POLL

        .ctrl-block(*ngIf='mode === "STREAM"')
            .ctrl-label Sub-mode
            .ctrl-row
                label([class.selected]='streamMode === "TARGET_DEFINED"')
                    input(type='radio', name='streamMode', value='TARGET_DEFINED', [(ngModel)]='streamMode')
                    span TARGET
                label([class.selected]='streamMode === "ON_CHANGE"')
                    input(type='radio', name='streamMode', value='ON_CHANGE', [(ngModel)]='streamMode')
                    span ON_CHANGE
                label([class.selected]='streamMode === "SAMPLE"')
                    input(type='radio', name='streamMode', value='SAMPLE', [(ngModel)]='streamMode')
                    span SAMPLE

        .ctrl-block(*ngIf='mode === "STREAM" && streamMode === "SAMPLE"')
            .ctrl-label Sample interval (s)
            input.ctrl-input(type='number', min='1', [(ngModel)]='sampleIntervalSec')

        .ctrl-block
            .ctrl-label
                span Add path
                a.ctrl-refresh(
                    href='javascript:void(0)',
                    (click)='toggleCatalogVisible()',
                    [class.on]='catalogVisible',
                    title='Browse the built-in path catalog'
                )
                    i.fas.fa-book-open
            input.ctrl-input(
                type='text',
                placeholder='/openconfig/… or pick from catalog ↓',
                [(ngModel)]='newSubPath',
                (keydown.enter)='addSubscription()'
            )
            button.ctrl-primary((click)='addSubscription()', [disabled]='!newSubPath.trim()')
                i.fas.fa-plus.me-1
                span Subscribe

        //- Catalog picker — toggled by the book icon in the "Add path"
        //- header. Categories collapsed by default; auto-expands the
        //- first category on open so it's not a wall of headers. Click
        //- an entry to fill the path input + apply suggested mode /
        //- interval; user still hits Subscribe to actually start.
        .ctrl-block.catalog-block(*ngIf='catalogVisible')
            .ctrl-label
                span Catalog
                span.catalog-count {{ catalogResultCount }}
            input.ctrl-input.catalog-search(
                type='text',
                placeholder='search paths…',
                [(ngModel)]='catalogQuery'
            )
            .catalog-empty(*ngIf='!catalogGroups.length') No paths match.
            .catalog-groups
                .catalog-group(*ngFor='let group of catalogGroups; trackBy: trackCatalogGroup')
                    .catalog-group-head(
                        (click)='toggleCatalogGroup(group.category)',
                        [class.expanded]='catalogExpanded === group.category'
                    )
                        i.fas.fa-chevron-right.chevron
                        span.category {{ group.category }}
                        span.count {{ group.entries.length }}
                    .catalog-entries(*ngIf='catalogExpanded === group.category')
                        .catalog-entry(
                            *ngFor='let entry of group.entries; trackBy: trackCatalogEntry',
                            (click)='pickCatalogEntry(entry)',
                            title='Click to fill the path input'
                        )
                            .catalog-entry-head
                                span.label {{ entry.label }}
                                span.vendor(*ngIf='entry.vendor') {{ entry.vendor }}
                            .catalog-path {{ entry.path }}
                            .catalog-desc {{ entry.description }}

        .ctrl-block
            .ctrl-label
                span Capabilities
                a.ctrl-refresh(
                    href='javascript:void(0)',
                    (click)='loadCapabilities()',
                    [class.loading]='capabilitiesLoading',
                    title='Refresh'
                )
                    i.fas.fa-sync-alt

            .capabilities-panel(*ngIf='capabilities && !capabilitiesError')
                .row
                    span.k gNMI
                    span.v {{ capabilities.gnmiVersion }}
                .row
                    span.k Encodings
                    span.v {{ capabilities.supportedEncodings.join(', ') || '—' }}
                .row
                    span.k Models
                    span.v {{ capabilities.supportedModels.length }}
                .row
                    span.k Vendor
                    span.v {{ profile?.options?.vendor || '—' }}

            .capabilities-loading(*ngIf='capabilitiesLoading && !capabilities')
                i.fas.fa-spinner.fa-spin.me-2
                span Fetching capabilities…

            .capabilities-error(*ngIf='capabilitiesError && !capabilitiesLoading')
                strong Capabilities failed
                .err-detail {{ capabilitiesError }}

    //- ───────────────── Status footer ─────────────────
    .session-status
        span.status-dot(
            [class.live]='subscriptions.length && subscriptions[0].running',
            [class.dead]='!subscriptions.length || !subscriptions[0].running'
        )
        span.mono {{ profile?.options?.host }}:{{ profile?.options?.port }}
        span.sep ·
        span {{ profile?.options?.security }}
        span.sep ·
        span {{ subscriptions.length }} subs
        span.sep ·
        span {{ totalReceived }} recv
        span.right(*ngIf='receiveRate > 0') {{ receiveRate }} msg/s

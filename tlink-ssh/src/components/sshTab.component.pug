terminal-toolbar([tab]='this')
    i.fas.fa-xs.fa-circle.text-success.me-2(*ngIf='session && session.open && !connectionStale')
    i.fas.fa-xs.fa-circle.text-warning.me-2(*ngIf='session && session.open && connectionStale')
    i.fas.fa-xs.fa-circle.text-danger.me-2(*ngIf='!session || !session.open')
    strong.me-auto(
        style='user-select: text; cursor: text;'
        onclick='event.stopPropagation()'
    ) {{profile.options.user?.trim()}}@{{profile.options.host?.trim()}}:{{profile.options.port}}

    small.text-muted.me-2(*ngIf='session && session.open && sessionStartTime')
        i.fas.fa-clock.me-1
        | {{getSessionDuration()}}
    small.text-muted.me-2(*ngIf='session && session.open && (bytesReceived > 0 || bytesSent > 0)')
        i.fas.fa-exchange-alt.me-1
        | {{getFormattedBandwidth()}}

    .me-2(*ngIf='session')
        button.btn.btn-sm.btn-link(
            (click)='openSessionLogDirectory()',
            [ngbTooltip]='"Session log directory"|translate',
            container='body'
        )
            i.far.fa-folder-open
        button.btn.btn-sm.btn-link(
            (click)='openSessionLogFile()',
            [ngbTooltip]='"Session log file"|translate',
            container='body'
        )
            i.far.fa-file-alt

    button.btn.btn-sm.btn-link.me-2(
        (click)='reconnect()',
        [ngbTooltip]='"Reconnect"|translate',
        container='body'
    )
        i.fas.fa-redo

    button.btn.btn-sm.btn-link.me-2(
        (click)='openSFTP()',
        *ngIf='session && session.open',
        [ngbTooltip]='"SFTP"|translate',
        container='body'
    )
        //- Distinct from the .far.fa-folder-open used for the local session-log
        //- directory above. SFTP opens a remote file tree, so the tree icon
        //- communicates that better and the two buttons are now visually
        //- separable side-by-side in the toolbar.
        i.fas.fa-folder-tree

    button.btn.btn-sm.btn-link(
        *ngIf='session && session.open && hostApp.platform !== Platform.Web',
        (click)='showPortForwarding()',
        [ngbTooltip]='"Ports"|translate',
        container='body'
    )
        i.fas.fa-plug

    //- Network-vendor snippet picker. Always available on an open shell;
    //- the modal itself shows a "(detected)" hint and lets the user
    //- override the platform if auto-detect missed.
    button.btn.btn-sm.btn-link(
        *ngIf='session && session.open',
        (click)='showSnippetPicker()',
        [ngbTooltip]='"Network snippets"|translate',
        container='body'
    )
        i.fas.fa-bolt

    button.btn.btn-sm.btn-link(
        *ngIf='aiAvailable && session && session.open',
        (click)='askAI()',
        [ngbTooltip]='"Ask AI"|translate',
        container='body'
    )
        i.fas.fa-robot

    //- Help dialog — searchable quick-reference. Always available
    //- (whether the session is open or not — the docs are equally
    //- relevant when troubleshooting a failed connect).
    button.btn.btn-sm.btn-link(
        (click)='openHelp()',
        [ngbTooltip]='"Help"|translate',
        container='body'
    )
        i.fas.fa-question-circle


sftp-panel.bg-dark(
    @panelSlide,
    [@.disabled]='!config.store.accessibility.animations',
    [(path)]='sftpPath',
    *ngIf='sftpPanelVisible && sshSession',
    (click)='$event.stopPropagation()',
    [session]='sshSession!',
    [cwdDetectionAvailable]='session?.supportsWorkingDirectory() ?? false',
    (closed)='sftpPanelVisible = false'
)

keyboard-interactive-auth-panel.bg-dark(
    *ngIf='activeKIPrompt',
    [prompt]='activeKIPrompt',
    [profile]='profile',
    [username]='sshSession?.authUsername ?? profile.options.user',
    (click)='$event.stopPropagation()',
    (done)='activeKIPrompt = null; frontend?.focus()'
)

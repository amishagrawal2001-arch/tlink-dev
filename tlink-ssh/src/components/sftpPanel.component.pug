.resize-handle((mousedown)='startResize($event)')
.header
    .path-section.d-flex.align-items-center
        .path-info.flex-grow-1.d-flex.flex-column.gap-1
            .path-display.d-flex.align-items-center.gap-2(*ngIf='editingPath === null')
                button.btn.btn-link.btn-sm.path-button(
                    type='button',
                    (click)='editPath()',
                    [title]='path || "/"'
                )
                    i.fas.fa-edit.me-1
                    span Path
                span.path-value.flex-grow-1 {{path || '/'}}
            .input-group.flex-grow-1(*ngIf='editingPath !== null', (mousedown)='$event.stopPropagation()', (click)='$event.stopPropagation()')
                input.form-control.path-input(
                    type='text',
                    #pathInput,
                    (keydown.enter)='confirmPath()',
                    (keydown.esc)='cancelEditPath()',
                    (mousedown)='$event.stopPropagation()',
                    (click)='$event.stopPropagation()',
                    [(ngModel)]='editingPath'
                )
                button.btn.btn-outline-secondary.path-edit-close(
                    type='button',
                    (click)='confirmPath()',
                    [disabled]='!editingPath || editingPath.trim() === ""'
                )
                    i.fas.fa-check
                button.btn.btn-outline-secondary.path-edit-close(
                    type='button',
                    (click)='cancelEditPath()'
                )
                    i.fas.fa-times
        //- Breadcrumb removed to avoid duplicating the path display.

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(*ngIf='!showFilter', (click)='showFilter = true')
        i.fas.fa-filter.me-1
        div(translate) Filter

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='openCreateDirectoryModal()')
        i.fas.fa-plus.me-1
        div(translate) Create directory

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='upload()')
        i.fas.fa-upload.me-1
        div(translate) Upload files

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex((click)='uploadFolder()')
        i.fas.fa-upload.me-1
        div(translate) Upload folder

    button.btn.btn-link.btn-sm.flex-shrink-0.d-flex(
        (click)='toggleBookmark()',
        [title]='isBookmarked ? "Remove bookmark" : "Bookmark this path"'
    )
        i.fas.fa-star.me-1([class.text-warning]='isBookmarked')
        div(translate) {{ isBookmarked ? 'Saved' : 'Save' }}

    .btn-group.flex-shrink-0(*ngIf='bookmarks.length > 0', ngbDropdown)
        button.btn.btn-link.btn-sm.d-flex(ngbDropdownToggle)
            i.fas.fa-bookmark.me-1
            div(translate) Bookmarks
        .dropdown-menu(ngbDropdownMenu)
            button.dropdown-item.d-flex.align-items-center(
                *ngFor='let bm of bookmarks',
                (click)='navigateToBookmark(bm)'
            )
                i.fas.fa-folder.me-2.text-muted
                span.me-auto {{bm}}
                button.btn.btn-sm.btn-link.text-danger.p-0.ms-2(
                    (click)='removeBookmark(bm, $event)',
                    title='Remove'
                )
                    i.fas.fa-times

    button.btn.btn-link.text-decoration-none((click)='close()') !{require('../../../tlink-core/src/icons/times.svg')}

.filter-bar.px-3.py-2.border-bottom(*ngIf='showFilter')
    .input-group
        input.form-control(
            type='text',
            placeholder='Filter...',
            autofocus,
            [(ngModel)]='filterText',
            (input)='onFilterChange()',
            (keydown.escape)='clearFilter()'
        )
        button.btn.btn-secondary((click)='clearFilter()')
            i.fas.fa-times

.body(dropZone, (transfer)='uploadOneFolder($event)')
    a.alert.alert-info.d-flex.align-items-center(
        *ngIf='shouldShowCWDTip && !cwdDetectionAvailable',
        (click)='platform.openExternal("https://tlink.sh/go/cwd-detection")'
    )
        .me-auto
            strong(translate) Working directory detection
            div(translate) Learn how to allow Tlink to detect remote shell's working directory.
        button.close((click)='dismissCWDTip()')
            i.fas.fa-close

    div(*ngIf='!sftp', translate) Connecting
    div(*ngIf='sftp')
        div(*ngIf='fileList === null || isNavigating')
            span(translate) Loading...
            span.text-warning.ms-2(*ngIf='navigationWarning')
                | Taking longer than expected...
        .list-group.list-group-light(*ngIf='fileList !== null')
            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngIf='path !== "/" && (!showFilter || filterText.trim() === "")',
                (click)='goUp()'
            )
                i.fas.fa-fw.fa-level-up-alt
                div(translate) Go up
            .list-group-item.list-group-item-action.d-flex.align-items-center(
                *ngFor='let item of filteredFileList',
                (contextmenu)='showContextMenu(item, $event)',
                (click)='open(item)',
                (dblclick)='onDoubleClick(item, $event)'
            )
                i.fa-fw([class]='getIcon(item)')
                div {{item.name}}
                .me-auto
                .size(*ngIf='!item.isDirectory') {{item.size|filesize}}
                .date {{item.modified|tlinkDate}}
                .mode {{getModeString(item)}}
        .alert.alert-info.text-center.mt-3(*ngIf='fileList !== null && filteredFileList.length === 0 && showFilter && filterText.trim() !== ""')
            i.fas.fa-search.me-2
            span(translate) No files match the filter "{{filterText}}"

.transfer-progress.px-3.py-2.border-top(*ngIf='activeTransfers.length > 0')
    .d-flex.align-items-center.mb-1(*ngFor='let t of activeTransfers')
        i.fas.fa-file.text-muted.me-2
        small.me-2.text-truncate(style='max-width: 150px') {{t.getStatus() || 'Transferring...'}}
        ngb-progressbar.flex-grow-1.me-2(
            [value]='t.getTotalSize() > 0 ? (t.getCompletedBytes() / t.getTotalSize() * 100) : 0',
            [striped]='!t.isComplete()',
            [animated]='!t.isComplete()',
            type='success',
            height='8px'
        )
        small.text-muted.me-2(*ngIf='t.getSpeed() > 0') {{(t.getSpeed() / 1024 / 1024).toFixed(1)}} MB/s
        button.btn.btn-sm.btn-link.text-danger.p-0(
            *ngIf='!t.isComplete()',
            (click)='cancelTransfer(t)'
        )
            i.fas.fa-times

{
  "name": "tlink-collector",
  "version": "1.0.0-nightly.1",
  "description": "Metrics-collector client for Tlink — pull data from Telegraf / Prometheus / any HTTP scrape endpoint (or a built-in Mock generator). Separate from tlink-gnmi (which subscribes to devices directly).",
  "keywords": [
    "tlink-builtin-plugin",
    "prometheus",
    "telegraf",
    "metrics",
    "telemetry"
  ],
  "main": "dist/index.js",
  "typings": "typings/index.d.ts",
  "scripts": {
    "build": "webpack --progress --color",
    "watch": "webpack --progress --color --watch"
  },
  "files": [
    "dist",
    "typings"
  ],
  "author": "Tlink Developers",
  "license": "MIT",
  "devDependencies": {
    "ansi-colors": "^4.1.1",
    "@types/node": "14.14.31"
  },
  "peerDependencies": {
    "@angular/animations": "^15",
    "@angular/common": "^15",
    "@angular/core": "^15",
    "@angular/forms": "^15",
    "@angular/platform-browser": "^15",
    "@ng-bootstrap/ng-bootstrap": "^14",
    "rxjs": "^7",
    "tlink-core": "*",
    "tlink-settings": "*",
    "tlink-terminal": "*"
  }
}

ul.nav-tabs(ngbNav, #nav='ngbNav')
    li(ngbNavItem)
        a(ngbNavLink, translate) General
        ng-template(ngbNavContent)
            .mb-3
                label(translate) Host
                input.form-control(
                    type='text',
                    [(ngModel)]='profile.options.host',
                )

            .mb-3
                label(translate) Port
                input.form-control(
                    type='number',
                    placeholder='3389',
                    [(ngModel)]='profile.options.port',
                )

            .mb-3
                button.btn.btn-outline-primary.btn-sm(
                    type='button',
                    (click)='testConnection()',
                    [disabled]='testing || !profile.options.host'
                )
                    i.fas.fa-plug.me-1
                    span(translate) Test Connection
                    i.fas.fa-spinner.fa-spin.ms-1(*ngIf='testing')
                .mt-1(*ngIf='testResult')
                    .text-success(*ngIf='testResult.success') Connected ({{testResult.latencyMs}}ms)
                    .text-danger(*ngIf='!testResult.success') {{testResult.error}}

            .mb-3
                label(translate) Username
                input.form-control(
                    type='text',
                    [(ngModel)]='profile.options.user',
                )

            .mb-3
                label(translate) Domain
                input.form-control(
                    type='text',
                    [(ngModel)]='profile.options.domain',
                    placeholder='(optional)',
                )

            .mb-3
                label(translate) Password
                .input-group
                    input.form-control(
                        [type]='showPassword ? "text" : "password"',
                        [(ngModel)]='profile.options.password',
                        placeholder='(leave empty to use keychain)',
                    )
                    button.btn.btn-outline-secondary(
                        type='button',
                        (click)='showPassword = !showPassword',
                        [attr.aria-label]='showPassword ? "Hide password" : "Show password"'
                    )
                        i.fa([ngClass]='showPassword ? "fa-eye-slash" : "fa-eye"')
                .mt-1.d-flex.gap-2
                    button.btn.btn-sm.btn-outline-success(
                        type='button',
                        (click)='saveToKeychain()',
                        [disabled]='!profile.options.password || !profile.options.host'
                    )
                        i.fas.fa-key.me-1
                        span(translate) Save to Keychain
                    button.btn.btn-sm.btn-outline-danger(
                        type='button',
                        (click)='clearFromKeychain()'
                    )
                        i.fas.fa-trash.me-1
                        span(translate) Clear Saved

            .mb-3
                label(translate) RDP Client
                select.form-control([(ngModel)]='profile.options.clientType')
                    option([value]="'node-rdpjs'") node-rdpjs (Embedded, SSL-only)
                    option([value]="'xfreerdp'") FreeRDP (External, NLA/TLS support)
                    option([value]="'rdp-file'") System RDP Client (Microsoft Remote Desktop)
                .alert.alert-info.mt-2.py-2.px-3.small(*ngIf="profile.options.clientType === 'node-rdpjs'")
                    i.fas.fa-info-circle.me-1
                    span(translate) Built-in client. Renders the remote desktop directly inside the tab. Supports SSL security only — may not work with servers that require NLA (Network Level Authentication). No additional software needed.

                .alert.alert-info.mt-2.py-2.px-3.small(*ngIf="profile.options.clientType === 'xfreerdp'")
                    i.fas.fa-info-circle.me-1
                    span(translate) Opens the remote desktop in a native window. Supports NLA, TLS, and modern Windows servers. Bundled with the app — no additional installation required.

                .alert.alert-info.mt-2.py-2.px-3.small(*ngIf="profile.options.clientType === 'rdp-file'")
                    i.fas.fa-info-circle.me-1
                    span(translate) Generates a .rdp file and opens it with your system's default RDP application. You will be prompted for the password by the external app.

                .alert.alert-warning.mt-2.py-2.px-3.d-flex.align-items-center.gap-2(
                    *ngIf="profile.options.clientType === 'rdp-file' && !rdpHandlerInstalled"
                )
                    i.fas.fa-exclamation-triangle
                    span.flex-grow-1
                        strong(translate) Prerequisite:&nbsp;
                        span(translate) No system RDP client detected.
                    button.btn.btn-sm.btn-warning((click)='installRDPClient()')
                        i.fas.fa-download.me-1
                        span(translate) Install

            .mb-3.d-flex.gap-2
                button.btn.btn-sm.btn-outline-secondary(
                    type='button',
                    (click)='exportProfile()'
                )
                    i.fas.fa-file-export.me-1
                    span(translate) Export Profile
                button.btn.btn-sm.btn-outline-secondary(
                    type='button',
                    (click)='importProfile()'
                )
                    i.fas.fa-file-import.me-1
                    span(translate) Import Profile

    li(ngbNavItem)
        a(ngbNavLink, translate) Display
        ng-template(ngbNavContent)
            .mb-3
                label(translate) Width
                input.form-control(
                    type='number',
                    [(ngModel)]='profile.options.width',
                )

            .mb-3
                label(translate) Height
                input.form-control(
                    type='number',
                    [(ngModel)]='profile.options.height',
                )

            .mb-3
                label(translate) Color Depth
                select.form-control([(ngModel)]='profile.options.colorDepth')
                    option([value]='8') 8-bit (256 colors)
                    option([value]='16') 16-bit (High Color)
                    option([value]='24') 24-bit (True Color)
                    option([value]='32') 32-bit (True Color + Alpha)

    li(ngbNavItem)
        a(ngbNavLink, translate) Features
        ng-template(ngbNavContent)
            .mb-3
                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableAudio',
                        id='enableAudio'
                    )
                    label.form-check-label(for='enableAudio', translate) Enable Audio Redirection

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableClipboard',
                        id='enableClipboard'
                    )
                    label.form-check-label(for='enableClipboard', translate) Enable Clipboard Sharing

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enablePrinting',
                        id='enablePrinting'
                    )
                    label.form-check-label(for='enablePrinting', translate) Enable Printer Redirection

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableDrives',
                        id='enableDrives'
                    )
                    label.form-check-label(for='enableDrives', translate) Enable Drive Mapping

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableWallpaper',
                        id='enableWallpaper'
                    )
                    label.form-check-label(for='enableWallpaper', translate) Enable Wallpaper

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableThemes',
                        id='enableThemes'
                    )
                    label.form-check-label(for='enableThemes', translate) Enable Themes

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableFontSmoothing',
                        id='enableFontSmoothing'
                    )
                    label.form-check-label(for='enableFontSmoothing', translate) Enable Font Smoothing

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableDesktopComposition',
                        id='enableDesktopComposition'
                    )
                    label.form-check-label(for='enableDesktopComposition', translate) Enable Desktop Composition

    li(ngbNavItem)
        a(ngbNavLink, translate) Security
        ng-template(ngbNavContent)
            .mb-3
                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableNLA',
                        id='enableNLA'
                    )
                    label.form-check-label(for='enableNLA', translate) Enable Network Level Authentication (NLA)

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.enableTLS',
                        id='enableTLS'
                    )
                    label.form-check-label(for='enableTLS', translate) Enable TLS Encryption

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.ignoreCertificate',
                        id='ignoreCertificate'
                    )
                    label.form-check-label(for='ignoreCertificate', translate) Ignore Certificate Errors

    li(ngbNavItem)
        a(ngbNavLink, translate) Performance
        ng-template(ngbNavContent)
            .mb-3
                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.compression',
                        id='compression'
                    )
                    label.form-check-label(for='compression', translate) Enable Compression

                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='profile.options.bitmapCaching',
                        id='bitmapCaching'
                    )
                    label.form-check-label(for='bitmapCaching', translate) Enable Bitmap Caching

            .mt-3
                h6(translate) Session Logging
                .form-check
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='sessionLogEnabled',
                        id='sessionLogEnabled',
                        (ngModelChange)='onSessionLogToggle($event)'
                    )
                    label.form-check-label(for='sessionLogEnabled', translate) Enable Session Logging
                .form-check.ms-3(*ngIf='sessionLogEnabled')
                    input.form-check-input(
                        type='checkbox',
                        [(ngModel)]='sessionLogInputEvents',
                        id='sessionLogInputEvents',
                        (ngModelChange)='onSessionLogInputToggle($event)'
                    )
                    label.form-check-label(for='sessionLogInputEvents', translate) Log keyboard and mouse events

    li(ngbNavItem)
        a(ngbNavLink, translate) Advanced
        ng-template(ngbNavContent)
            .mb-3
                label(translate) Custom FreeRDP Parameters
                input.form-control(
                    type='text',
                    [(ngModel)]='profile.options.customParams',
                    placeholder='/flag1 /flag2 +option',
                )
                small.form-text.text-muted(translate) Additional command-line arguments passed to FreeRDP. Space-separated. Only applies to FreeRDP client type.

div([ngbNavOutlet]='nav')

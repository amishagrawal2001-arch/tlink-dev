//- The spacer doubles as a hover-peek zone when the toolbar is enabled
//- but not pinned. Without this, hover-revealing the toolbar is
//- impossible — the toolbar element itself is translated offscreen
//- with `transform: translate(0, -100px)`, so the mouse can't
//- physically enter it. The spacer is a thin (4px) always-visible
//- strip that captures the hover and triggers showToolbar().
.terminal-toolbar-spacer(
    (mouseenter)='showToolbar()',
    (mouseleave)='hideToolbar()'
)
terminal-toolbar([tab]='this')
.terminal-pane-close(
    *ngIf='showInPaneClose',
    [ngbTooltip]='"Close pane"|translate',
    container='body'
)
    button.btn.btn-sm.btn-link(type='button', (click)='closePane()', aria-label='Close pane')
        i.fas.fa-times
.content(#content, [style.opacity]='frontendIsReady ? 1 : 0')
search-panel(
    *ngIf='showSearchPanel && hasFocus && frontend',
    @toolbarSlide,
    [@.disabled]='!config.store.accessibility.animations',
    [frontend]='frontend',
    (close)='showSearchPanel = false; frontend.cancelSearch()'
)
terminal-button-bar([tab]='this')

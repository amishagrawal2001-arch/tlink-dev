div
    h3.mb-3(translate) Rendering

    .form-line(*ngIf='hostApp.platform !== Platform.Web')
        .header
            .title(translate)
                | Frontend
                i.fas.fa-question-circle.ms-2(
                    [ngbTooltip]='"WebGL is faster but may not work on all systems. Canvas is the fallback."',
                    container='body',
                    style='font-size: 10px; opacity: 0.4; cursor: help;'
                )
            .description(translate) Switches terminal frontend implementation (experimental)

        select.form-control(
            [(ngModel)]='config.store.terminal.frontend',
            (ngModelChange)='config.save()',
        )
            option(value='xterm-webgl') xterm (WebGL)
            option(value='xterm') xterm (canvas)

    .form-line
        .header
            .title(translate)
                | Scrollback
                i.fas.fa-question-circle.ms-2(
                    [ngbTooltip]='"How many lines of terminal output to keep in memory. Higher values use more RAM. Default: 25000"',
                    container='body',
                    style='font-size: 10px; opacity: 0.4; cursor: help;'
                )
            .description(translate) Number of lines kept in the buffer
        input.form-control(
            type='number',
            [(ngModel)]='config.store.terminal.scrollbackLines',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate) Disable alternate screen buffer
            .description(translate) Keeps scrollback for full-screen apps
        toggle(
            [(ngModel)]='config.store.terminal.disableAlternateScreen',
            (ngModelChange)='config.save()'
        )

    .form-line
        .header
            .title(translate) Selection colors (dark mode)
            .description(translate) Applies when using the dark color scheme
        .d-flex.flex-wrap.gap-2
            color-picker(
                [(model)]='config.store.terminal.colorScheme.selection',
                (modelChange)='config.save()',
                title='SB',
                hint='Selection background'
            )
            color-picker(
                [(model)]='config.store.terminal.colorScheme.selectionForeground',
                (modelChange)='config.save()',
                title='SF',
                hint='Selection foreground'
            )

    .form-line
        .header
            .title(translate) Selection colors (light mode)
            .description(translate) Applies when using the light color scheme
        .d-flex.flex-wrap.gap-2
            color-picker(
                [(model)]='config.store.terminal.lightColorScheme.selection',
                (modelChange)='config.save()',
                title='SB',
                hint='Selection background'
            )
            color-picker(
                [(model)]='config.store.terminal.lightColorScheme.selectionForeground',
                (modelChange)='config.save()',
                title='SF',
                hint='Selection foreground'
            )

    .form-line
        .header
            .title(translate)
                | Draw bold text in bright colors
                i.fas.fa-question-circle.ms-2(
                    [ngbTooltip]='"When enabled, bold text uses the bright variant of its ANSI color (colors 8-15) instead of the normal variant (colors 0-7)."',
                    container='body',
                    style='font-size: 10px; opacity: 0.4; cursor: help;'
                )
        toggle(
            [(ngModel)]='config.store.terminal.drawBoldTextInBrightColors',
            (ngModelChange)='config.save()'
        )

    .form-line
        .header
            .title(translate)
                | Output keyword highlighting
                i.fas.fa-question-circle.ms-2(
                    [ngbTooltip]='"Applies color to keywords like UP, DOWN, ERROR in terminal output using regex patterns. Colors are applied client-side and do not affect the actual data."',
                    container='body',
                    style='font-size: 10px; opacity: 0.4; cursor: help;'
                )
            .description(translate) Apply client-side colors to matched words in terminal output
        toggle(
            [(ngModel)]='config.store.terminal.outputHighlighting.enabled',
            (ngModelChange)='config.save()'
        )

    div(*ngIf='config.store.terminal.outputHighlighting.enabled', style='padding: 0 16px;')
        .d-flex.align-items-center.mb-2
            span(style='font-size: 12px; font-weight: 600; opacity: 0.7;', translate) Highlighting Rules
            .ms-auto
                button.btn.btn-link.btn-sm.p-0.me-3((click)='resetHighlightRules()', style='font-size: 11px; opacity: 0.5;')
                    span(translate) Reset
                button.btn.btn-link.btn-sm.p-0((click)='addHighlightRule()', style='font-size: 11px;')
                    i.fas.fa-plus.me-1
                    span(translate) Add

        div(style='display: flex; flex-direction: column; gap: 2px;')
            .d-flex.align-items-center(
                *ngFor='let rule of config.store.terminal.outputHighlighting.rules; let i = index',
                style='gap: 6px; padding: 3px 0;'
            )
                .color-swatch-wrapper(style='position: relative; width: 20px; height: 20px; flex-shrink: 0;')
                    div(
                        [style.background-color]='rule.color',
                        style='width: 100%; height: 100%; border-radius: 4px; border: 1px solid rgba(255,255,255,0.15);'
                    )
                    input(
                        type='color',
                        [(ngModel)]='rule.color',
                        (ngModelChange)='config.save()',
                        style='position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%;'
                    )
                input.form-control.form-control-sm(
                    type='text',
                    [(ngModel)]='rule.pattern',
                    (ngModelChange)='config.save()',
                    style='flex: 1; font-family: "SF Mono", monospace; font-size: 11px; padding: 2px 6px; height: 24px; background: rgba(0,0,0,0.15); border: 1px solid rgba(255,255,255,0.08); border-radius: 3px;'
                )
                input.form-control.form-control-sm(
                    type='text',
                    [(ngModel)]='rule.flags',
                    (ngModelChange)='config.save()',
                    [ngbTooltip]='"g = all matches, i = case insensitive, m = multiline"',
                    container='body',
                    style='width: 32px; font-family: monospace; font-size: 11px; padding: 2px 4px; height: 24px; text-align: center; background: rgba(0,0,0,0.15); border: 1px solid rgba(255,255,255,0.08); border-radius: 3px;'
                )
                span(
                    [style.color]='rule.color',
                    style='font-size: 10px; font-weight: 700; font-family: monospace; width: 16px; text-align: center;'
                ) Aa
                button.btn.btn-sm.p-0(
                    (click)='removeHighlightRule(i)',
                    style='width: 20px; height: 20px; display: flex; align-items: center; justify-content: center; background: transparent; border: none; color: inherit; opacity: 0.2; font-size: 10px;',
                    onmouseenter='this.style.opacity="1"; this.style.color="#dc3545"',
                    onmouseleave='this.style.opacity="0.2"; this.style.color="inherit"'
                )
                    i.fas.fa-times

    .form-line
        .header
            .title(translate) Sixel graphics support (experimental)
            .description(translate) Display images via Sixel escape sequences
        toggle(
            [(ngModel)]='config.store.terminal.sixel',
            (ngModelChange)='config.save(); config.requestRestart()'
        )

div.mt-4
    h3(translate) Button bar

    .form-line
        .header
            .title(translate) Show button bar
            .description(translate) Display custom command buttons above terminals
        toggle(
            [(ngModel)]='config.store.terminal.buttonBar.enabled',
            (ngModelChange)='config.save()'
        )

    div(*ngIf='config.store.terminal.buttonBar.enabled')
        .form-line
            .header
                .title(translate) Buttons
                .description(translate) Use \\r for Enter, \\n for newline, \\t for tab, \\e for escape, \\b for backspace, \\p for 1s pause, \\\\ for backslash, \\v for clipboard

        .mb-2(*ngFor='let button of config.store.terminal.buttonBar.buttons; index as i; trackBy: trackByIndex')
            .input-group.flex-grow-1
                input.form-control.w-25(
                    type='text',
                    placeholder='Label',
                    [(ngModel)]='button.label',
                    (ngModelChange)='config.save()',
                )
                select.form-control.w-auto(
                    [(ngModel)]='button.action',
                    (ngModelChange)='config.save()',
                )
                    option(*ngFor='let action of buttonActions', [ngValue]='action.value') {{action.label}}
                input.form-control.w-50(
                    type='text',
                    placeholder='Command',
                    [(ngModel)]='button.command',
                    (ngModelChange)='config.save()',
                )
                select.form-control.w-auto(
                    [(ngModel)]='button.color',
                    (ngModelChange)='config.save()',
                )
                    option(*ngFor='let color of buttonColors', [ngValue]='color.value') {{color.label}}
                .input-group-text
                    label.form-check.mb-0
                        input.form-check-input(
                            type='checkbox',
                            [(ngModel)]='button.appendEnter',
                            (ngModelChange)='config.save()',
                        )
                        span.ms-1(translate) Enter
                .input-group-text
                    label.form-check.mb-0
                        input.form-check-input(
                            type='checkbox',
                            [(ngModel)]='button.disableTooltip',
                            (ngModelChange)='config.save()',
                        )
                        span.ms-1(translate) Tooltip
                button.btn.btn-secondary((click)='removeButton(button)')
                    i.fas.fa-fw.fa-trash
            .mt-1
                input.form-control(
                    type='text',
                    placeholder='Description',
                    [(ngModel)]='button.description',
                    (ngModelChange)='config.save()',
                )
            .mt-1(*ngIf='button.action !== "send-string"')
                input.form-control(
                    type='text',
                    placeholder='Script arguments (optional)',
                    [(ngModel)]='button.scriptArgs',
                    (ngModelChange)='config.save()',
                )

        button.btn.btn-secondary.mt-2((click)='addButton()')
            i.fas.fa-plus.me-2
            span(translate) Add button

div.mt-4
    h3(translate) Keyboard

    .form-line
        .header
            .title(
                translate="Use {altKeyName} as the Meta key",
                [translateParams]='{altKeyName: altKeyName}'
            )
            .description(translate) Lets the shell handle Meta key instead of OS
        toggle(
            [(ngModel)]='config.store.terminal.altIsMeta',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate) Scroll on input
            .description(translate) Scrolls the terminal to the bottom on user input
        toggle(
            [(ngModel)]='config.store.terminal.scrollOnInput',
            (ngModelChange)='config.save()',
        )

div.mt-4
    h3(translate) Mouse

    .form-line
        .header
            .title(translate) Right click
            .description(*ngIf='config.store.terminal.rightClick == "paste"', translate) Long-click for context menu

        select.form-control(
            [(ngModel)]='config.store.terminal.rightClick',
            (ngModelChange)='config.save()'
        )
            option(ngValue='off', translate) Off
            option(ngValue='menu', translate) Context menu
            option(ngValue='paste', translate) Paste
            option(ngValue='clipboard', translate) Paste if no selection, else copy

    .form-line
        .header
            .title(translate) Paste on middle-click

        toggle(
            [(ngModel)]='config.store.terminal.pasteOnMiddleClick',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate) Word separators
            .description(translate) Double-click selection will stop at these characters
        input.form-control(
            type='text',
            placeholder=' ()[]{}\'"',
            [(ngModel)]='config.store.terminal.wordSeparator',
            (ngModelChange)='config.save()',
        )

    .form-line(*ngIf='config.store.clickableLinks')
        .header
            .title(translate) Require a key to click links
            .description(translate) When enabled, links are only clickable while holding this key

        select.form-control(
            [(ngModel)]='config.store.clickableLinks.modifier',
            (ngModelChange)='config.save()',
        )
            option([ngValue]='null', translate) No modifier
            option(value='ctrlKey', *ngIf='hostApp.platform !== Platform.macOS') Ctrl
            option(value='altKey') {{altKeyName}}
            option(value='shiftKey') Shift
            option(value='metaKey') {{metaKeyName}}

.mt-4
    h3(translate) Clipboard

    .form-line
        .header
            .title(translate)
                | Copy on select
                i.fas.fa-question-circle.ms-2(
                    [ngbTooltip]='"Automatically copies selected text to clipboard without pressing Cmd+C / Ctrl+C"',
                    container='body',
                    style='font-size: 10px; opacity: 0.4; cursor: help;'
                )
        toggle(
            [(ngModel)]='config.store.terminal.copyOnSelect',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate) Copy with formatting
        toggle(
            [(ngModel)]='config.store.terminal.copyAsHTML',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate)
                | Bracketed paste
                i.fas.fa-question-circle.ms-2(
                    [ngbTooltip]='"Wraps pasted text in escape sequences so the shell knows it was pasted, not typed. Prevents accidental execution of multi-line commands. Requires shell support (bash 4.4+, zsh, fish)."',
                    container='body',
                    style='font-size: 10px; opacity: 0.4; cursor: help;'
                )
            .description(translate) Prevents accidental execution of pasted commands
        toggle(
            [(ngModel)]='config.store.terminal.bracketedPaste',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate) Warn on multi-line paste
            .description(translate) Show a confirmation box when pasting multiple lines
        toggle(
            [(ngModel)]='config.store.terminal.warnOnMultilinePaste',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate) Trim whitespace and newlines
            .description(translate) Remove whitespace and newlines around the copied text
        toggle(
            [(ngModel)]='config.store.terminal.trimWhitespaceOnPaste',
            (ngModelChange)='config.save()',
        )

div.mt-4
    h3(translate) Sound

    .form-line
        .header
            .title(translate) Terminal bell
        .btn-group
            input.btn-check(
                type='radio',
                name='bell',
                [(ngModel)]='config.store.terminal.bell',
                (ngModelChange)='config.save()',
                id='bellOff',
                [value]='"off"'
            )
            label.btn.btn-secondary(for='bellOff')
                span(translate) Off
            input.btn-check(
                type='radio',
                name='bell',
                [(ngModel)]='config.store.terminal.bell',
                (ngModelChange)='config.save()',
                id='bellVisual',
                [value]='"visual"'
            )
            label.btn.btn-secondary(for='bellVisual')
                span(translate) Visual
            input.btn-check(
                type='radio',
                name='bell',
                [(ngModel)]='config.store.terminal.bell',
                (ngModelChange)='config.save()',
                id='bellAudible',
                [value]='"audible"'
            )
            label.btn.btn-secondary(for='bellAudible')
                span(translate) Audible

    .alert.alert-info.d-flex.align-items-center(*ngIf='config.store.terminal.bell != "audible" && (config.store.terminal.profile || "").startsWith("wsl")')
        .me-auto(translate) WSL terminal bell can only be muted via Volume Mixer
        button.btn.btn-secondary((click)='openWSLVolumeMixer()', translate) Show Mixer

.mt-4
    h3(translate) Startup

    .form-line(*ngIf='hostApp.platform !== Platform.Web')
        .header
            .title(translate) Auto-open a terminal on app start

        toggle(
            [(ngModel)]='config.store.terminal.autoOpen',
            (ngModelChange)='config.save()',
        )

    .form-line
        .header
            .title(translate) Restore terminal tabs on app start

        toggle(
            [(ngModel)]='config.store.recoverTabs',
            (ngModelChange)='config.save()',
        )

div.mt-4(*ngIf='hostApp.platform === Platform.Windows')
    h3(translate) Windows

    .form-line
        .header
            .title(translate) Set Tlink as %COMSPEC%
            .description(translate) Allows opening .bat files in tabs, but breaks some shells
        toggle(
            [(ngModel)]='config.store.terminal.setComSpec',
            (ngModelChange)='config.save()',
        )

.chart-tile([class.alert-active]='data.alert', [class.alert-info]='data.alert?.severity === "info"', [class.alert-warning]='data.alert?.severity === "warning"', [class.alert-critical]='data.alert?.severity === "critical"')
    .alert-badge(*ngIf='data.alert', [class.alert-badge-info]='data.alert.severity === "info"', [class.alert-badge-warning]='data.alert.severity === "warning"', [class.alert-badge-critical]='data.alert.severity === "critical"', [title]='data.alert.predicate')
        .dot
        .chip {{ data.alert.severity | uppercase }}
    .head
        .label(title='{{ tile.path }}') {{ label }}
        .current(*ngIf='hasValue')
            span.value.mono {{ data.current }}
            span.unit(*ngIf='data.unit')  {{ data.unit }}
            span.delta.mono(*ngIf='data.delta', [class.delta-up]='data.delta.kind === "up"', [class.delta-down]='data.delta.kind === "down"', [class.delta-same]='data.delta.kind === "same"')  {{ data.delta.label }}
        .current.dash(*ngIf='!hasValue') —
    .chart-wrap
        svg.chart(*ngIf='chart', viewBox='0 0 100 50', preserveAspectRatio='none')
            line.grid(x1='0', y1='12', x2='100', y2='12')
            line.grid(x1='0', y1='25', x2='100', y2='25')
            line.grid(x1='0', y1='38', x2='100', y2='38')
            path.area([attr.d]='chart.area')
            path.line([attr.d]='chart.line')
            circle.endpoint([attr.cx]='chart.endX', [attr.cy]='chart.endY', r='2.5')
            text.y-min(*ngIf='minLabel', x='1', y='48') {{ minLabel }}
            text.y-max(*ngIf='maxLabel', x='1', y='10') {{ maxLabel }}
        .chart-empty.dash(*ngIf='!chart') —
    .foot(*ngIf='data.ageLabel')
        .age.mono {{ data.ageLabel }}

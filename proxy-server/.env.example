# Server Configuration
PORT=3052
NODE_ENV=production
ENABLE_ADMIN_UI=true
ADMIN_TOKEN=change_me_admin_token
# Adds ADMIN_TOKEN into / and /admin redirect URLs as ?adminToken=...
# Set to false to disable this behavior.
ADMIN_URL_INCLUDE_TOKEN=false
# Optional: second factor for admin APIs
# ADMIN_OTP_SECRET=change_me_otp
# ADMIN_TOTP_SECRET=BASE32SECRET

# API Keys (get from respective providers)
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Provider Selection Strategy
# Options: "round-robin", "cheapest", "fastest", "random"
PROVIDER_STRATEGY=round-robin

# CORS (for web clients)
ALLOWED_ORIGINS=http://localhost:*,https://yourdomain.com

# Authentication (optional - for premium tiers)
# JWT_SECRET=your_jwt_secret_here
# ENABLE_AUTH=false

# Self-service security: do not return claim links/tokens in API responses by default.
SELF_SERVICE_EXPOSE_LINK=false

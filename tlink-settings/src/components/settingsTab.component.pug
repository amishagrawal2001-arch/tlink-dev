.content
    ul.nav-pills(ngbNav, #nav='ngbNav', [activeId]='activeTab', orientation='vertical', (navChange)='$event.nextId === "license" && loadMyDevices()')
        li(ngbNavItem='application')
            a(ngbNavLink)
                i.fas.fa-fw.fa-window-maximize.me-2
                span(translate) Application
            ng-template(ngbNavContent)
                .content-box
                    .row
                        .col-12.col-md-6
                            .logo-area
                                .tlink-logo.mt-3

                                h1.tlink-title Tlink
                                    sup α
                                .text-muted {{homeBase.appVersion}}

                                button.btn.btn-secondary.mt-3.mb-2(
                                    *ngIf='!updateAvailable && hostApp.platform !== Platform.Web',
                                    (click)='checkForUpdates()',
                                    [disabled]='checkingForUpdate'
                                )
                                    i.fas.fa-sync(
                                        [class.fa-spin]='checkingForUpdate'
                                    )
                                    span(translate) Check for updates

                                button.btn.btn-info.mt-3.mb-2(
                                    *ngIf='updateAvailable',
                                    (click)='updater.update()',
                                )
                                    i.fas.fa-sync
                                    span(translate) Update

                        .col-12.col-md-6
                            .list-group.list-group-light.mb-5
                                button.list-group-item.list-group-item-action.link-card((click)='homeBase.reportBug()')
                                    i.fas.fa-fw.fa-bug
                                    div
                                        div(translate) Report a problem
                                        small.text-muted(translate) Generate a pre-filled GitHub issue

                                button.list-group-item.list-group-item-action.link-card((click)='homeBase.openDiscord()')
                                    i.fab.fa-fw.fa-discord
                                    div
                                        div(translate) Community
                                        small.text-muted(translate) On Discord

                                button.list-group-item.list-group-item-action.link-card((click)='homeBase.openGitHub()')
                                    i.fab.fa-fw.fa-github
                                    div
                                        div GitHub
                                        small.text-muted(translate) Source code

                                button.list-group-item.list-group-item-action.link-card((click)='showReleaseNotes()')
                                    i.fas.fa-fw.fa-book
                                    div
                                        div(translate) What's new
                                        small.text-muted(translate) Show release notes


                    h3(translate) Application settings
                    .form-line
                        .header
                            .title(translate) Language
                            a.description((click)='homeBase.openTranslations()')
                                span(translate) Help translate Tlink
                                i.fas.fa-external-link-square-alt.ms-1
                        select.form-control([(ngModel)]='config.store.language', (ngModelChange)='saveConfiguration(true)')
                            option([ngValue]='null', translate) Automatic
                            option(
                                [value]='lang.code',
                                *ngFor='let lang of allLanguages'
                            ) {{lang.name}}

                    .form-line(*ngIf='platform.isShellIntegrationSupported()')
                        .header
                            .title(translate) Shell integration
                            .description(translate) Allows quickly opening a terminal in the selected folder
                        toggle([ngModel]='isShellIntegrationInstalled', (ngModelChange)='toggleShellIntegration()')

                    .form-line(*ngIf='hostApp.platform !== Platform.Web')
                        .header
                            .title(translate) Enable analytics
                            .description(translate) We're only tracking your Tlink and OS versions.
                        toggle(
                            [(ngModel)]='config.store.enableAnalytics',
                            (ngModelChange)='saveConfiguration(true)',
                        )

                    .form-line(*ngIf='hostApp.platform !== Platform.Web')
                        .header
                            .title(translate) Automatic Updates
                            .description(translate) Enable automatic installation of updates when they become available.
                        toggle([(ngModel)]='config.store.enableAutomaticUpdates', (ngModelChange)='saveConfiguration()')

                    .form-line(*ngIf='hostApp.platform !== Platform.Web')
                        .header
                            .title(translate) Debugging

                        button.btn.btn-secondary((click)='hostWindow.openDevTools()')
                            i.fas.fa-bug
                            span(translate) Open DevTools

                    h3(translate) Accessibility
                    .form-line
                        .header
                            .title(translate) Enable animations
                        toggle([(ngModel)]='config.store.accessibility.animations', (ngModelChange)='saveConfiguration()')

                    .form-line
                        .header
                            .title(translate) Minimum contrast ratio
                        input.form-control(
                            type='number',
                            min='1',
                            max='21',
                            step='0.5',
                            [(ngModel)]='config.store.terminal.minimumContrastRatio',
                            (ngModelChange)='config.save()'
                        )

        ng-container(*ngFor='let provider of settingsProviders')
            li(*ngIf='provider.prioritized', [ngbNavItem]='provider.id')
                a.d-flex.align-items-center(ngbNavLink)
                    i(class='fas fa-fw me-2 fa-{{provider.icon}}')
                    span {{provider.title|translate}}
                ng-template(ngbNavContent)
                    settings-tab-body([provider]='provider')

        .mb-3

        ng-container(*ngFor='let provider of settingsProviders')
            li(*ngIf='!provider.prioritized', [ngbNavItem]='provider.id')
                a.d-flex.align-items-center(ngbNavLink)
                    i(class='fas fa-fw me-2 fa-{{provider.icon || "puzzle-piece"}}')
                    span {{provider.title|translate}}
                ng-template(ngbNavContent)
                    settings-tab-body([provider]='provider')

        li(ngbNavItem='license')
            a.d-flex.align-items-center(ngbNavLink)
                i.fas.fa-fw.fa-key.me-2
                span(translate) License
            ng-template(ngbNavContent)
                .content-box
                    h3(translate) License Management

                    .license-status-card.mb-4(
                        [class.card-trial]='licenseSvc.billingType === "TRIAL" && licenseSvc.licenseStatus === "active"',
                        [class.card-pro]='licenseSvc.licenseType === "INDIVIDUAL" && licenseSvc.billingType === "PAID" && licenseSvc.licenseStatus === "active"',
                        [class.card-enterprise]='licenseSvc.licenseType === "TEAM" && licenseSvc.licenseStatus === "active"',
                        [class.card-expired]='licenseSvc.licenseStatus !== "active"'
                    )
                        .d-flex.align-items-center
                            span.license-tier-badge(
                                [class.badge-trial]='licenseSvc.billingType === "TRIAL" && licenseSvc.licenseStatus === "active"',
                                [class.badge-pro]='licenseSvc.licenseType === "INDIVIDUAL" && licenseSvc.billingType === "PAID" && licenseSvc.licenseStatus === "active"',
                                [class.badge-enterprise]='licenseSvc.licenseType === "TEAM" && licenseSvc.licenseStatus === "active"',
                                [class.badge-expired]='licenseSvc.licenseStatus !== "active"'
                            )
                                ng-container(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.isLocalTrial') TRIAL {{ licenseSvc.trialDaysRemaining }}d
                                ng-container(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial && licenseSvc.billingType === "TRIAL"') TRIAL
                                ng-container(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial && licenseSvc.billingType === "PAID" && licenseSvc.licenseType === "TEAM"') TEAM
                                ng-container(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial && licenseSvc.billingType === "PAID" && licenseSvc.licenseType === "INDIVIDUAL"') INDIVIDUAL
                                ng-container(*ngIf='licenseSvc.licenseStatus === "expired"') EXPIRED
                                ng-container(*ngIf='licenseSvc.licenseStatus === "unauthenticated"') NOT SIGNED IN
                                ng-container(*ngIf='licenseSvc.licenseStatus === "invalid"') INVALID
                            .ms-3.d-flex.flex-column(style='line-height:1.3')
                                //- Logged in with a known email: show it.
                                strong.license-account(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.userEmail') {{ licenseSvc.userEmail }}
                                //- Active but email not yet hydrated from server (old bundle). Don't mislead the user.
                                strong.license-account(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.userEmail && !licenseSvc.isLocalTrial') Signed in
                                //- Local 30-day trial — genuinely not signed in yet.
                                strong.license-account(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.isLocalTrial') Local trial — not signed in
                                //- All non-active states.
                                strong.license-account(*ngIf='licenseSvc.licenseStatus !== "active"') Not signed in
                                small.text-muted(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.endDate') Expires {{ licenseSvc.endDate }}
                                small.text-muted(*ngIf='licenseSvc.licenseStatus !== "active"') Please sign in to continue

                    h5.mt-4(*ngIf='!licenseSvc.userEmail', translate) Sign in
                    h5.mt-4(*ngIf='licenseSvc.userEmail', translate) Switch account
                    .form-line
                        .header
                            .title(translate) Email
                        .license-input-row
                            input.form-control(
                                type='email',
                                autocomplete='email',
                                [(ngModel)]='licenseEmailInput',
                                placeholder='you@example.com'
                            )
                    .form-line
                        .header
                            .title(translate) Password
                        .license-input-row
                            input.form-control(
                                type='password',
                                autocomplete='current-password',
                                [(ngModel)]='licensePasswordInput',
                                placeholder='Your password',
                                (keydown.enter)='activateLicense()'
                            )
                            button.btn.btn-primary.license-btn((click)='activateLicense()') Sign in
                    .text-danger.mt-1.small(*ngIf='licenseError') {{ licenseError }}
                    .text-success.mt-1.small(*ngIf='licenseSuccess') {{ licenseSuccess }}

                    h5.mt-4(translate) License Details
                    .form-line
                        .header
                            .title(translate) Status
                        span.license-detail-badge(
                            [class.detail-active]='licenseSvc.licenseStatus === "active"',
                            [class.detail-trial]='licenseSvc.billingType === "TRIAL" && licenseSvc.licenseStatus === "active"',
                            [class.detail-expired]='licenseSvc.licenseStatus === "expired"'
                        ) {{ licenseSvc.licenseStatus | uppercase }}{{ licenseSvc.offlineGrace ? ' (OFFLINE)' : '' }}

                    .form-line(*ngIf='licenseSvc.userEmail')
                        .header
                            .title(translate) Account
                        span {{ licenseSvc.userEmail }}

                    .form-line(*ngIf='licenseSvc.licenseStatus === "active"')
                        .header
                            .title(translate) License
                        span {{ licenseSvc.licenseType }} / {{ licenseSvc.billingType }}

                    .form-line(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.endDate')
                        .header
                            .title(translate) Expires
                        span {{ licenseSvc.endDate }}

                    .form-line(*ngIf='licenseSvc.deviceId')
                        .header
                            .title(translate) Device ID
                        code.license-code {{ licenseSvc.deviceId }}

                    //- Device fingerprint — always shown (even without an active
                    //- license) so users in offline / blocked-network environments
                    //- can send it to their admin when requesting an offline
                    //- activation code. Admin pastes the value into the "Device
                    //- fingerprint" field when minting the code; the resulting
                    //- code then only works on THIS machine.
                    .form-line
                        .header
                            .title(translate) Device fingerprint
                            .description(translate) Send this to your admin when requesting an offline activation code so the code is bound to this device.
                        .license-input-row
                            input.form-control(
                                type='text',
                                readonly,
                                [value]='deviceFingerprint || "(computing…)"'
                            )
                            button.btn.btn-secondary.license-btn(
                                [disabled]='!deviceFingerprint',
                                (click)='copyDeviceFingerprint()'
                            )
                                i.fas.me-1([class.fa-check]='fingerprintCopied', [class.fa-copy]='!fingerprintCopied')
                                | {{ fingerprintCopied ? 'Copied' : 'Copy' }}

                    h5.mt-4(translate) License Server
                    .form-line
                        .header
                            .title(translate) Server URL
                            .description(translate) Host, API root, or licenses-rooted URL — endpoints derived automatically.
                        .license-input-row
                            input.form-control(
                                type='text',
                                [(ngModel)]='serverUrl',
                                placeholder='http://localhost:4000 or https://…/api/v1'
                            )
                            button.btn.btn-secondary.license-btn((click)='testServerConnection()') Test
                            button.btn.btn-primary.license-btn((click)='saveServerUrl()') Save
                    .small.mt-1(*ngIf='serverTestResult')
                        span([class.text-success]='serverTestResult.startsWith("connected")', [class.text-danger]='!serverTestResult.startsWith("connected")') {{ serverTestResult }}

                    //- Product code override. Sent in the activate / validate
                    //- request body. Lets a user fix a PRODUCT_NOT_ENTITLED
                    //- rejection without rebuilding the app.
                    .form-line
                        .header
                            .title(translate) Product Code
                            .description(translate) Sent with activate/validate. Override only if your tenant uses a non-default product slug.
                        .license-input-row
                            input.form-control(
                                type='text',
                                [(ngModel)]='productCode',
                                placeholder='tyllink_terminal'
                            )
                            button.btn.btn-primary.license-btn((click)='saveProductCode()') Save
                    .small.mt-1.text-success(*ngIf='productCodeSaved', translate) Saved

                    //- Self-service device portal — lists all devices this
                    //- account is signed in on and lets the user deactivate
                    //- any seat without admin involvement.
                    h5.mt-4(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial', translate) My Devices
                    .d-flex.align-items-center.mb-2(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial')
                        .small.text-muted(style='flex:1') Every device your account has activated. Click Deactivate to free a seat.
                        button.btn.btn-sm.btn-outline-secondary(
                            [disabled]='devicesLoading',
                            (click)='loadMyDevices()'
                        )
                            i.fas.me-1([class.fa-sync-alt]='!devicesLoading', [class.fa-spinner]='devicesLoading', [class.fa-spin]='devicesLoading')
                            | {{ devicesLoading ? 'Loading…' : 'Refresh' }}

                    table.table.table-sm.small(
                        *ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial && myDevices.length',
                        style='font-size:12px'
                    )
                        thead
                            tr
                                th Product
                                th Platform
                                th App version
                                th Last seen
                                th Status
                                th
                        tbody
                            tr(*ngFor='let d of myDevices')
                                td
                                    code(style='font-size:11px') {{ d.product_code }}
                                    span.badge.bg-primary.ms-1(*ngIf='d.is_current', style='font-size:9px') THIS DEVICE
                                td {{ d.platform }} {{ d.os_version }}
                                td {{ d.app_version }}
                                td {{ d.last_seen_at ? (d.last_seen_at | date:'short') : '—' }}
                                td
                                    span.badge.bg-success(*ngIf='!d.deactivated_at', style='font-size:10px') active
                                    span.badge.bg-secondary(*ngIf='d.deactivated_at', style='font-size:10px') deactivated
                                td(style='white-space:nowrap')
                                    button.btn.btn-sm.btn-outline-danger(
                                        *ngIf='!d.deactivated_at',
                                        [disabled]='deactivatingDeviceId === d.id',
                                        (click)='deactivateMyDevice(d)'
                                    )
                                        i.fas.fa-spinner.fa-spin.me-1(*ngIf='deactivatingDeviceId === d.id')
                                        | {{ deactivatingDeviceId === d.id ? 'Deactivating…' : 'Deactivate' }}

                    .small.text-muted(
                        *ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial && !myDevices.length && !devicesLoading'
                    ) No devices found. Try Refresh.

                    .d-flex.gap-3.mt-4
                        //- Manual refresh — hits /api/licenses/refresh right now
                        //- instead of waiting for the ~13-min preemptive timer.
                        button.btn.btn-outline-secondary(
                            *ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial',
                            [disabled]='licenseRefreshing',
                            (click)='refreshLicense()'
                        )
                            i.fas.me-2(
                                [class.fa-sync-alt]='!licenseRefreshing',
                                [class.fa-spinner]='licenseRefreshing',
                                [class.fa-spin]='licenseRefreshing'
                            )
                            | {{ licenseRefreshing ? 'Refreshing…' : 'Refresh license' }}

                        //- Always visible so users can reset local state even
                        //- when there's no active session (useful when the
                        //- bundle is stale or the trial is stuck).
                        button.btn.btn-outline-danger((click)='deactivateLicense()')
                            i.fas.fa-sign-out-alt.me-2
                            | Sign out / reset local state
                        a.btn.btn-outline-primary(href='https://tlink.io/buy', target='_blank') Buy License

        li(ngbNavItem='config-file')
            a.d-flex.align-items-center(ngbNavLink)
                i.fas.fa-fw.fa-code.me-2
                span(translate) Config file
            ng-template.test(ngbNavContent)
                .d-flex.flex-column.w-100.h-100
                    .h-100.d-flex
                        .w-100.d-flex.flex-column
                            h3(translate) Config file
                            textarea.form-control.h-100(
                                [(ngModel)]='configFile'
                            )
                        .w-100.d-flex.flex-column(*ngIf='showConfigDefaults')
                            h3(translate) Defaults
                            textarea.form-control.h-100(
                                [(ngModel)]='configDefaults',
                                readonly
                            )
                    .mt-3.d-flex
                        button.btn.btn-primary((click)='saveConfigFile()', *ngIf='isConfigFileValid()')
                            i.fas.fa-check.me-2
                            span(translate) Save and apply
                        button.btn.btn-primary(disabled, *ngIf='!isConfigFileValid()')
                            i.fas.fa-exclamation-triangle.me-2
                            span(translate) Invalid syntax
                        button.btn.btn-secondary.ms-auto(
                            (click)='showConfigDefaults = !showConfigDefaults',
                            translate
                        ) Show defaults
                        button.btn.btn-secondary.ms-3(
                            *ngIf='platform.getConfigPath()',
                            (click)='showConfigFile()'
                        )
                            i.fas.fa-external-link-square-alt.me-2
                            span(translate) Show config file

    div([ngbNavOutlet]='nav')

button.btn.btn-warning.btn-block(
    *ngIf='config.restartRequested',
    (click)='restartApp()',
    translate
) Restart the app to apply changes

.content
    ul.nav-pills(ngbNav, #nav='ngbNav', [activeId]='activeTab', orientation='vertical')
        li(ngbNavItem='application')
            a(ngbNavLink)
                i.fas.fa-fw.fa-window-maximize.me-2
                span(translate) Application
            ng-template(ngbNavContent)
                .content-box
                    .row
                        .col-12.col-md-6
                            .logo-area
                                .tlink-logo.mt-3

                                h1.tlink-title Tlink
                                    sup α
                                .text-muted {{homeBase.appVersion}}

                                button.btn.btn-secondary.mt-3.mb-2(
                                    *ngIf='!updateAvailable && hostApp.platform !== Platform.Web',
                                    (click)='checkForUpdates()',
                                    [disabled]='checkingForUpdate'
                                )
                                    i.fas.fa-sync(
                                        [class.fa-spin]='checkingForUpdate'
                                    )
                                    span(translate) Check for updates

                                button.btn.btn-info.mt-3.mb-2(
                                    *ngIf='updateAvailable',
                                    (click)='updater.update()',
                                )
                                    i.fas.fa-sync
                                    span(translate) Update

                        .col-12.col-md-6
                            .list-group.list-group-light.mb-5
                                button.list-group-item.list-group-item-action.link-card((click)='homeBase.reportBug()')
                                    i.fas.fa-fw.fa-bug
                                    div
                                        div(translate) Report a problem
                                        small.text-muted(translate) Generate a pre-filled GitHub issue

                                button.list-group-item.list-group-item-action.link-card((click)='homeBase.openDiscord()')
                                    i.fab.fa-fw.fa-discord
                                    div
                                        div(translate) Community
                                        small.text-muted(translate) On Discord

                                button.list-group-item.list-group-item-action.link-card((click)='homeBase.openGitHub()')
                                    i.fab.fa-fw.fa-github
                                    div
                                        div GitHub
                                        small.text-muted(translate) Source code

                                button.list-group-item.list-group-item-action.link-card((click)='showReleaseNotes()')
                                    i.fas.fa-fw.fa-book
                                    div
                                        div(translate) What's new
                                        small.text-muted(translate) Show release notes


                    h3(translate) Application settings
                    .form-line
                        .header
                            .title(translate) Language
                            a.description((click)='homeBase.openTranslations()')
                                span(translate) Help translate Tlink
                                i.fas.fa-external-link-square-alt.ms-1
                        select.form-control([(ngModel)]='config.store.language', (ngModelChange)='saveConfiguration(true)')
                            option([ngValue]='null', translate) Automatic
                            option(
                                [value]='lang.code',
                                *ngFor='let lang of allLanguages'
                            ) {{lang.name}}

                    .form-line(*ngIf='platform.isShellIntegrationSupported()')
                        .header
                            .title(translate) Shell integration
                            .description(translate) Allows quickly opening a terminal in the selected folder
                        toggle([ngModel]='isShellIntegrationInstalled', (ngModelChange)='toggleShellIntegration()')

                    .form-line(*ngIf='hostApp.platform !== Platform.Web')
                        .header
                            .title(translate) Enable analytics
                            .description(translate) We're only tracking your Tlink and OS versions.
                        toggle(
                            [(ngModel)]='config.store.enableAnalytics',
                            (ngModelChange)='saveConfiguration(true)',
                        )

                    .form-line(*ngIf='hostApp.platform !== Platform.Web')
                        .header
                            .title(translate) Automatic Updates
                            .description(translate) Enable automatic installation of updates when they become available.
                        toggle([(ngModel)]='config.store.enableAutomaticUpdates', (ngModelChange)='saveConfiguration()')

                    .form-line(*ngIf='hostApp.platform !== Platform.Web')
                        .header
                            .title(translate) Debugging

                        button.btn.btn-secondary((click)='hostWindow.openDevTools()')
                            i.fas.fa-bug
                            span(translate) Open DevTools

                    h3(translate) Accessibility
                    .form-line
                        .header
                            .title(translate) Enable animations
                        toggle([(ngModel)]='config.store.accessibility.animations', (ngModelChange)='saveConfiguration()')

                    .form-line
                        .header
                            .title(translate) Minimum contrast ratio
                        input.form-control(
                            type='number',
                            min='1',
                            max='21',
                            step='0.5',
                            [(ngModel)]='config.store.terminal.minimumContrastRatio',
                            (ngModelChange)='config.save()'
                        )

        ng-container(*ngFor='let provider of settingsProviders')
            li(*ngIf='provider.prioritized', [ngbNavItem]='provider.id')
                a.d-flex.align-items-center(ngbNavLink)
                    i(class='fas fa-fw me-2 fa-{{provider.icon}}')
                    span {{provider.title|translate}}
                ng-template(ngbNavContent)
                    settings-tab-body([provider]='provider')

        .mb-3

        ng-container(*ngFor='let provider of settingsProviders')
            li(*ngIf='!provider.prioritized', [ngbNavItem]='provider.id')
                a.d-flex.align-items-center(ngbNavLink)
                    i(class='fas fa-fw me-2 fa-{{provider.icon || "puzzle-piece"}}')
                    span {{provider.title|translate}}
                ng-template(ngbNavContent)
                    settings-tab-body([provider]='provider')

        li(ngbNavItem='license')
            a.d-flex.align-items-center(ngbNavLink)
                i.fas.fa-fw.fa-key.me-2
                span(translate) License
            ng-template(ngbNavContent)
                .content-box.license-content
                    h3(translate) License Management

                    .license-status-card.mb-4(
                        [class.card-trial]='licenseSvc.billingType === "TRIAL" && licenseSvc.licenseStatus === "active"',
                        [class.card-pro]='licenseSvc.licenseType === "INDIVIDUAL" && licenseSvc.billingType === "PAID" && licenseSvc.licenseStatus === "active"',
                        [class.card-enterprise]='licenseSvc.licenseType === "TEAM" && licenseSvc.licenseStatus === "active"',
                        [class.card-expired]='licenseSvc.licenseStatus !== "active"'
                    )
                        .d-flex.align-items-center.flex-wrap(style='gap:10px')
                            span.live-dot(*ngIf='licenseSvc.licenseStatus === "active"', title='Heartbeat active')
                            span.license-tier-badge(
                                [class.badge-trial]='licenseSvc.billingType === "TRIAL" && licenseSvc.licenseStatus === "active"',
                                [class.badge-pro]='licenseSvc.licenseType === "INDIVIDUAL" && licenseSvc.billingType === "PAID" && licenseSvc.licenseStatus === "active"',
                                [class.badge-enterprise]='licenseSvc.licenseType === "TEAM" && licenseSvc.licenseStatus === "active"',
                                [class.badge-expired]='licenseSvc.licenseStatus !== "active"'
                            )
                                ng-container(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.isLocalTrial') TRIAL
                                ng-container(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial && licenseSvc.billingType === "TRIAL"') TRIAL
                                ng-container(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial && licenseSvc.billingType === "PAID" && licenseSvc.licenseType === "TEAM"') TEAM
                                ng-container(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial && licenseSvc.billingType === "PAID" && licenseSvc.licenseType === "INDIVIDUAL"') INDIVIDUAL
                                ng-container(*ngIf='licenseSvc.licenseStatus === "expired"') EXPIRED
                                ng-container(*ngIf='licenseSvc.licenseStatus === "unauthenticated"') NOT SIGNED IN
                                ng-container(*ngIf='licenseSvc.licenseStatus === "invalid"') INVALID
                            .d-flex.flex-column.flex-grow-1(style='line-height:1.3; min-width:200px')
                                //- Logged in with a known email: show it.
                                strong.license-account(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.userEmail') {{ licenseSvc.userEmail }}
                                //- Active but email not yet hydrated from server (old bundle). Don't mislead the user.
                                strong.license-account(*ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.userEmail && !licenseSvc.isLocalTrial') Signed in
                                //- Local 30-day trial — genuinely not signed in yet.
                                strong.license-account(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.isLocalTrial') Local trial — not signed in
                                //- All non-active states.
                                strong.license-account(*ngIf='licenseSvc.licenseStatus !== "active"') Not signed in
                                small.text-muted(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.endDate') Expires {{ formatExpiry() }}
                                small.text-muted(*ngIf='licenseSvc.licenseStatus !== "active"') Please sign in to continue

                        //- Trial progress bar — only on local trials. Shows
                        //- proportion of the 30-day window used up. Helps
                        //- communicate urgency without taking extra rows.
                        .trial-progress.mt-2(*ngIf='licenseSvc.licenseStatus === "active" && licenseSvc.isLocalTrial')
                            .trial-progress-fill([style.width.%]='trialProgressPercent()')
                            .trial-progress-label
                                | {{ licenseSvc.trialDaysRemaining }} of {{ licenseSvc.trialDurationDays }} trial days left

                    //- Working-offline notice — calmer messaging when a paid
                    //- user is in offlineGrace inside their subscription
                    //- period. Their endDate is the actual validity boundary;
                    //- the server just hasn't been reachable lately. Avoids
                    //- the alarming amber-triangle look that suggests "your
                    //- license has a problem".
                    .license-inline-notice.notice-info(
                        *ngIf='licenseSvc.offlineGrace && licenseSvc.paidAndWithinSubscription'
                    )
                        i.fas.fa-cloud.me-1
                        span Working offline — license valid through {{ formatExpiryDateOnly() }}.
                        span.notice-detail.ms-2(*ngIf='licenseSvc.lastServerContactAt') Last sync {{ formatLastServerContact() }}

                    //- Generic offline-grace warning — covers trial users in
                    //- offline grace (still need a server check-in to extend
                    //- past the 48h window) and any other case where we
                    //- don't have a paid endDate to fall back on.
                    .license-inline-notice.notice-warn(
                        *ngIf='licenseSvc.offlineGrace && !licenseSvc.paidAndWithinSubscription'
                    )
                        i.fas.fa-triangle-exclamation.me-1
                        span Server unreachable — running on cached credentials.
                        span.notice-detail.ms-2(*ngIf='licenseSvc.lastServerContactAt') Last sync {{ formatLastServerContact() }}

                    //- Approaching-expiry nudge — paid users in their last 14
                    //- days. Trials get the trial-progress bar above; this is
                    //- the equivalent for paid subscriptions so renewals don't
                    //- catch the user off guard.
                    .license-inline-notice.notice-warn.mt-2(*ngIf='showExpiryWarning()')
                        i.fas.fa-clock.me-1
                        span(*ngIf='daysUntilEndDate() === 0') Your license expires today.
                        span(*ngIf='daysUntilEndDate() === 1') Your license expires tomorrow.
                        span(*ngIf='daysUntilEndDate() > 1') Your license expires in {{ daysUntilEndDate() }} days.
                        a(href='https://tlink.io/buy', target='_blank') Renew

                    //- Sign-in form is heavy (two big inputs + button). When
                    //- the user is already signed in, hide it behind a
                    //- "Switch account" button so it doesn't dominate the
                    //- panel for users who just want to glance at status.
                    //- Fresh launch with no session → form stays expanded
                    //- (showSignInForm initialized from !userEmail in TS).
                    .d-flex.align-items-center.justify-content-between.mt-3(*ngIf='licenseSvc.userEmail && !showSignInForm')
                        .small.text-muted Signed in as <strong>{{ licenseSvc.userEmail }}</strong>
                        button.btn.btn-sm.btn-outline-secondary((click)='toggleSignInForm()')
                            i.fas.fa-user-edit.me-1
                            | Switch account

                    ng-container(*ngIf='showSignInForm')
                        h5.mt-4(*ngIf='!licenseSvc.userEmail')
                            i.fas.fa-sign-in-alt
                            span(translate) Sign in
                        h5.mt-4(*ngIf='licenseSvc.userEmail')
                            i.fas.fa-user-edit
                            span(translate) Switch account
                        .form-line
                            .header
                                .title(translate) Email
                            .license-input-row
                                .input-with-icon
                                    i.fas.fa-envelope.input-icon
                                    input.form-control(
                                        type='email',
                                        autocomplete='email',
                                        [(ngModel)]='licenseEmailInput',
                                        placeholder='you@example.com',
                                        [disabled]='licenseSigningIn'
                                    )
                        .form-line
                            .header
                                .title(translate) Password
                            .license-input-row
                                .input-with-icon
                                    i.fas.fa-lock.input-icon
                                    input.form-control(
                                        type='password',
                                        autocomplete='current-password',
                                        [(ngModel)]='licensePasswordInput',
                                        placeholder='Your password',
                                        [disabled]='licenseSigningIn',
                                        (keydown.enter)='activateLicense()'
                                    )
                                button.btn.btn-primary.license-btn(
                                    (click)='activateLicense()',
                                    [disabled]='licenseSigningIn'
                                )
                                    i.fas.me-1(
                                        [class.fa-spinner]='licenseSigningIn',
                                        [class.fa-spin]='licenseSigningIn',
                                        [class.fa-sign-in-alt]='!licenseSigningIn'
                                    )
                                    | {{ licenseSigningIn ? 'Signing in…' : 'Sign in' }}
                                button.btn.btn-link.btn-sm(
                                    *ngIf='licenseSvc.userEmail',
                                    (click)='toggleSignInForm()',
                                    [disabled]='licenseSigningIn'
                                ) Cancel
                        .text-danger.mt-1.small(*ngIf='licenseError') {{ licenseError }}
                        .text-success.mt-1.small(*ngIf='licenseSuccess') {{ licenseSuccess }}

                    //- License Details — used to repeat Status / Account /
                    //- License / Expires that already live in the status
                    //- card above. Trimmed to JUST the device-bound fields
                    //- (Device ID + fingerprint) which the card has no
                    //- room to show. Offline-grace flag is the one bit
                    //- that needs surfacing here when active, since the
                    //- status card doesn't communicate it.
                    h5.mt-4(*ngIf='licenseSvc.deviceId || true')
                        i.fas.fa-id-card
                        span(translate) Device

                    .form-line(*ngIf='licenseSvc.deviceId')
                        .header
                            .title(translate) Device ID
                        code.license-code {{ licenseSvc.deviceId }}

                    //- Device fingerprint — always shown (even without an active
                    //- license) so users in offline / blocked-network environments
                    //- can send it to their admin when requesting an offline
                    //- activation code. Admin pastes the value into the "Device
                    //- fingerprint" field when minting the code; the resulting
                    //- code then only works on THIS machine.
                    .form-line
                        .header
                            .title(translate) Device fingerprint
                            .description(translate) Send this to your admin when requesting an offline activation code so the code is bound to this device.
                        .license-input-row
                            .input-with-icon
                                i.fas.fa-fingerprint.input-icon
                                input.form-control(
                                    type='text',
                                    readonly,
                                    [value]='deviceFingerprint || "(computing…)"'
                                )
                            button.btn.btn-secondary.license-btn(
                                [disabled]='!deviceFingerprint',
                                (click)='copyDeviceFingerprint()'
                            )
                                i.fas.me-1([class.fa-check]='fingerprintCopied', [class.fa-copy]='!fingerprintCopied')
                                | {{ fingerprintCopied ? 'Copied' : 'Copy' }}

                    //- Offline activation — for users who can't reach the
                    //- license server (air-gapped network, blocked corporate
                    //- VPN, etc.). The activation dialog also exposes this
                    //- via "Have an activation code?", but the dialog only
                    //- opens when the user is signed out. Mirroring the
                    //- redeem flow here lets a trial user paste a code
                    //- without first signing out, and lets a paid user
                    //- redeem a refreshed offline code mid-session.
                    h5.mt-4
                        i.fas.fa-key
                        span(translate) Offline Activation
                    .form-line
                        .header
                            .title(translate) Activation code
                            .description(translate) Paste the code your admin generated for this device's fingerprint above. Verified locally — no network required.
                        button.btn.btn-outline-secondary(
                            *ngIf='!showOfflineActivation',
                            (click)='toggleOfflineActivation()'
                        )
                            i.fas.fa-key.me-1
                            | I have an activation code
                        .offline-activation-form(*ngIf='showOfflineActivation')
                            textarea.form-control.offline-code-input(
                                rows='5',
                                [(ngModel)]='offlineCodeInput',
                                placeholder='Paste the long activation code (starts with eyJ…)',
                                [disabled]='offlineRedeeming'
                            )
                            .d-flex.gap-2.mt-2.flex-wrap
                                button.btn.btn-primary(
                                    (click)='redeemOfflineCode()',
                                    [disabled]='offlineRedeeming || !offlineCodeInput.trim()'
                                )
                                    i.fas.me-1(
                                        [class.fa-spinner]='offlineRedeeming',
                                        [class.fa-spin]='offlineRedeeming',
                                        [class.fa-check]='!offlineRedeeming'
                                    )
                                    | {{ offlineRedeeming ? 'Verifying…' : 'Activate' }}
                                button.btn.btn-link.btn-sm(
                                    (click)='toggleOfflineActivation()',
                                    [disabled]='offlineRedeeming'
                                ) Cancel
                            .text-danger.mt-2.small(*ngIf='offlineRedeemError') {{ offlineRedeemError }}
                            .text-success.mt-2.small(*ngIf='offlineRedeemSuccess')
                                i.fas.fa-check-circle.me-1
                                | {{ offlineRedeemSuccess }}

                    h5.mt-4
                        i.fas.fa-server
                        span(translate) License Server
                    .form-line
                        .header
                            .title(translate) Server URL
                            .description(translate) Host, API root, or licenses-rooted URL — endpoints derived automatically.
                        .license-input-row
                            .input-with-icon
                                i.fas.fa-link.input-icon
                                input.form-control(
                                    type='text',
                                    [(ngModel)]='serverUrl',
                                    placeholder='http://localhost:4000 or https://…/api/v1'
                                )
                            button.btn.btn-secondary.license-btn((click)='testServerConnection()') Test
                            button.btn.btn-primary.license-btn((click)='saveServerUrl()') Save
                    .small.mt-1(*ngIf='serverTestResult')
                        span([class.text-success]='serverTestResult.startsWith("connected")', [class.text-danger]='!serverTestResult.startsWith("connected")') {{ serverTestResult }}

                    //- Product code override. Sent in the activate / validate
                    //- request body. Lets a user fix a PRODUCT_NOT_ENTITLED
                    //- rejection without rebuilding the app.
                    .form-line
                        .header
                            .title(translate) Product Code
                            .description(translate) Sent with activate/validate. Override only if your tenant uses a non-default product slug.
                        .license-input-row
                            .input-with-icon
                                i.fas.fa-tag.input-icon
                                input.form-control(
                                    type='text',
                                    [(ngModel)]='productCode',
                                    placeholder='tyllink_terminal'
                                )
                            button.btn.btn-primary.license-btn((click)='saveProductCode()') Save
                    .small.mt-1.text-success(*ngIf='productCodeSaved', translate) Saved

                    h5.mt-4
                        i.fas.fa-heartbeat
                        span(translate) Heartbeat
                    //- Heartbeat observability — read-only counters + a
                    //- "Run heartbeat now" button so users can verify the
                    //- license server is reachable on the configured cadence
                    //- without waiting up to 4h for the next periodic tick.
                    .form-line
                        .header
                            .title(translate) Status check
                            .description(translate) Periodic check-in to the license server. Triggers token rotation and revocation propagation.
                        .license-input-row
                            button.btn.btn-secondary.license-btn(
                                (click)='triggerHeartbeat()',
                                [disabled]='triggerHeartbeatRunning || licenseSvc.heartbeatDisabled'
                            )
                                | {{ triggerHeartbeatRunning ? 'Running…' : (licenseSvc.heartbeatDisabled ? 'Disabled' : 'Run now') }}
                    .license-inline-notice.notice-warn(*ngIf='licenseSvc.heartbeatDisabled')
                        i.fas.fa-exclamation-triangle.me-1
                        span Heartbeat disabled — server requires password on every check-in. Tokens stay valid until you sign out.
                        a(href='javascript:void(0)', (click)='licenseSvc.resetHeartbeatBackoff()', translate) Try again
                    .heartbeat-stats
                        span.stat-chip
                            span.stat-label Interval
                            span.stat-value {{ formatHeartbeatInterval() }}
                        span.stat-chip
                            span.stat-label Attempts
                            span.stat-value {{ licenseSvc.heartbeatAttemptCount }}
                        span.stat-chip.stat-ok(*ngIf='licenseSvc.heartbeatSuccesses > 0')
                            span.stat-label OK
                            span.stat-value {{ licenseSvc.heartbeatSuccesses }}
                        span.stat-chip.stat-error(*ngIf='licenseSvc.heartbeatFailures > 0')
                            span.stat-label Failed
                            span.stat-value {{ licenseSvc.heartbeatFailures }}
                        span.stat-chip(*ngIf='licenseSvc.heartbeatLastRunAt')
                            span.stat-label Last run
                            span.stat-value {{ formatHeartbeatLastRun() }}
                        span.stat-chip.stat-ok(*ngIf='licenseSvc.heartbeatLastResult.status === "ok"')
                            span.stat-label Last
                            span.stat-value OK ({{ licenseSvc.heartbeatLastResult.durationMs }}ms)
                        span.stat-chip.stat-warn(*ngIf='licenseSvc.heartbeatLastResult.status === "unreachable"')
                            span.stat-label Last
                            span.stat-value Unreachable
                        span.stat-chip.stat-error(*ngIf='licenseSvc.heartbeatLastResult.status === "invalid"')
                            span.stat-label Last
                            span.stat-value Invalid ({{ licenseSvc.heartbeatLastResult.reason }})
                        //- Sparkline visualizing the last ~24 heartbeat
                        //- durations. Tucked into the chip row so it
                        //- reads as one more piece of telemetry; quietly
                        //- disappears when there's no data yet.
                        span.stat-chip.heartbeat-sparkline-chip(*ngIf='heartbeatSparklinePoints()', title='Recent heartbeat durations')
                            span.stat-label Trend
                            svg.heartbeat-sparkline(viewBox='0 0 80 18', preserveAspectRatio='none')
                                polyline(
                                    fill='none',
                                    stroke='currentColor',
                                    stroke-width='1.4',
                                    stroke-linecap='round',
                                    stroke-linejoin='round',
                                    [attr.points]='heartbeatSparklinePoints()'
                                )

                    //- Action footer. Two groups: secondary actions left,
                    //- primary CTAs right. Top divider visually breaks the
                    //- panel from the form rows above so the buttons read
                    //- as a "what next" toolbar rather than another row.
                    .license-actions-footer.mt-4
                        .actions-group.actions-secondary
                            //- Manual refresh — hits /api/licenses/refresh
                            //- right now instead of waiting for the ~13-min
                            //- preemptive timer. Grey + retitle when the
                            //- server already proved it doesn't support
                            //- token-only refresh, so the user isn't
                            //- tempted to repeatedly click a doomed button.
                            button.btn.btn-outline-secondary(
                                *ngIf='licenseSvc.licenseStatus === "active" && !licenseSvc.isLocalTrial',
                                [disabled]='licenseRefreshing || licenseSvc.heartbeatDisabled',
                                [title]='licenseSvc.heartbeatDisabled ? "This server requires sign-in to refresh." : ""',
                                (click)='refreshLicense()'
                            )
                                i.fas.me-2(
                                    [class.fa-sync-alt]='!licenseRefreshing',
                                    [class.fa-spinner]='licenseRefreshing',
                                    [class.fa-spin]='licenseRefreshing'
                                )
                                | {{ licenseRefreshing ? 'Refreshing…' : (licenseSvc.heartbeatDisabled ? 'Refresh unavailable' : 'Refresh license') }}

                            //- Always visible so users can reset local
                            //- state even when there's no active session
                            //- (useful when the bundle is stale or the
                            //- trial is stuck).
                            button.btn.btn-outline-danger((click)='deactivateLicense()')
                                i.fas.fa-sign-out-alt.me-2
                                | Sign out

                        .actions-group.actions-primary
                            //- Primary CTA — sits at the far right where the
                            //- eye lands last. Outline-style avoids fighting
                            //- with form's own submit affordances above.
                            a.btn.btn-primary(href='https://tlink.io/buy', target='_blank')
                                i.fas.fa-shopping-cart.me-2
                                | Buy License

        li(ngbNavItem='config-file')
            a.d-flex.align-items-center(ngbNavLink)
                i.fas.fa-fw.fa-code.me-2
                span(translate) Config file
            ng-template.test(ngbNavContent)
                .d-flex.flex-column.w-100.h-100
                    .h-100.d-flex
                        .w-100.d-flex.flex-column
                            h3(translate) Config file
                            textarea.form-control.h-100(
                                [(ngModel)]='configFile'
                            )
                        .w-100.d-flex.flex-column(*ngIf='showConfigDefaults')
                            h3(translate) Defaults
                            textarea.form-control.h-100(
                                [(ngModel)]='configDefaults',
                                readonly
                            )
                    .mt-3.d-flex
                        button.btn.btn-primary((click)='saveConfigFile()', *ngIf='isConfigFileValid()')
                            i.fas.fa-check.me-2
                            span(translate) Save and apply
                        button.btn.btn-primary(disabled, *ngIf='!isConfigFileValid()')
                            i.fas.fa-exclamation-triangle.me-2
                            span(translate) Invalid syntax
                        button.btn.btn-secondary.ms-auto(
                            (click)='showConfigDefaults = !showConfigDefaults',
                            translate
                        ) Show defaults
                        button.btn.btn-secondary.ms-3(
                            *ngIf='platform.getConfigPath()',
                            (click)='showConfigFile()'
                        )
                            i.fas.fa-external-link-square-alt.me-2
                            span(translate) Show config file

    div([ngbNavOutlet]='nav')

button.btn.btn-warning.btn-block(
